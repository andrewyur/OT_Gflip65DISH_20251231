config TCT_DMCC
        tristate "RAM Compress and Clean"
        depends on SYSFS && SWAP
        default n
        help
          Creates background thread for compress and clean used RAM
          dynamiclly,enabled by write 1 to /sys/kernel/dmcc/enable.

